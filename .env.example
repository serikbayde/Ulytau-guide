# Скопируйте этот файл в .env и впишите свои значения:  cp .env.example .env
# Файл .env НЕ коммитить (он в .gitignore).

# Токен бота от @BotFather (формат 123456789:AA...)
BOT_TOKEN=

# Ключ Gemini API (бесплатно): https://aistudio.google.com/apikey
# Если оставить пустым — бот работает, а AI-гид вежливо сообщит, что недоступен.
GEMINI_API_KEY=

# Необязательные настройки (значения по умолчанию указаны ниже)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TIMEOUT=40
